# Copia este archivo como .env y completa tus valores de Supabase.
# Dashboard de Supabase → Project Settings → Data API / API keys.
# Preferir la clave publishable. ANON_KEY se conserva por compatibilidad.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tu-clave-publica

# Dominio institucional permitido para administradores (sin @).
VITE_ADMIN_EMAIL_DOMAIN=unsch.edu.pe

# SOLO servidor (Vercel). Nunca usar el prefijo VITE_ para secretos.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# El libro permanece cerrado hasta completar datos legales y correo.
CLAIMS_PROVIDER_NAME=
CLAIMS_PROVIDER_RUC=
CLAIMS_PROVIDER_ADDRESS=
CLAIMS_PRIVACY_EMAIL=
CLAIMS_PRIVACY_NOTICE=
RESEND_API_KEY=
CLAIMS_EMAIL_FROM=
